{
  // Build config: emits src to dist. rootDir/outDir live HERE rather than in
  // tsconfig.json because that config also covers test/ and vitest.config.ts,
  // which sit outside src — a rootDir spanning them would emit dist/src/... and
  // ship the tests. Without these two the build emitted beside the sources,
  // scattering .js/.d.ts through src/ where the linter then read them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "dist"]
}
