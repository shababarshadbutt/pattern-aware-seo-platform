{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "11",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": ["WEB_API_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["WEB_API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "POSTGRES_PORT",
        "REDIS_PORT",
        "REDIS_URL",
        "WEB_API_URL"
      ]
    }
  }
}
