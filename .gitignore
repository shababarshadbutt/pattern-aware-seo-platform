# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
.next/
dist/
build/
out/
coverage/
.turbo/
*.tsbuildinfo

# --- Env / secrets (never commit real values) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Logs / runtime ---
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# --- Python (ml-service) ---
ml-service/.venv/
ml-service/__pycache__/
ml-service/**/__pycache__/
ml-service/*.egg-info/
*.pyc

# --- Infra state (never commit Terraform/CDK state or plans) ---
infrastructure/**/.terraform/
infrastructure/**/*.tfstate
infrastructure/**/*.tfstate.*
infrastructure/**/*.tfplan
infrastructure/cdk.out/

# --- Local data / large test fixtures ---
*.sqlite
*.sql.gz
*.dump
tmp/
.cache/

# --- Reports generated by the platform itself (don't commit sample output) ---
*.csv
*.xlsx
!docs/**/*.csv
!docs/**/*.xlsx

# Downloaded sitemap files between pipeline stages (SITEMAP_STORE_ROOT).
# Real client sitemaps land here on a live run and must never be committed.
.sitemaps/
