{
  // Build config: emits the library and the test harness. The harness is
  // reachable only through the explicit "./testing" subpath (decided in
  // CODING_STANDARDS section 1.4, ADR-0023) and hands back the same opaque
  // `Database` handle, so it grants no unscoped query access. The tests
  // themselves and the drizzle-kit config are typechecked but never shipped.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "dist"]
}
