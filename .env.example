# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DATABASE_URL="postgresql://seo_platform:password@localhost:5432/seo_platform"

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- AWS (S3 / SFTP deploy) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_DEV_BUCKET=""

SFTP_HOST=""
SFTP_USER=""
SFTP_PRIVATE_KEY_PATH=""

# --- Auth (fill in once the internal-vs-external decision is made) ---
AUTH_SECRET=""

# --- ML service (once ml-service/ is active) ---
ML_SERVICE_URL="http://localhost:8000"

# --- App ---
NODE_ENV="development"
PORT=3000
