# Copy to .env and fill in real values. Never commit .env itself.
#
# Everything here is validated once at startup by packages/shared/src/config.ts.
# An invalid or missing required value fails the process immediately with a
# message naming the variable — it will not surface three jobs into a worker run.
#
# Only the REQUIRED block below has no default. Every commented value is the
# built-in default; uncomment only to override it.

# ============================================================
# REQUIRED
# ============================================================
DATABASE_URL="postgresql://seo_platform:password@localhost:5432/seo_platform"
REDIS_URL="redis://localhost:6379"

# ============================================================
# App
# ============================================================
# Where apps/web reaches the API from the server side. Declared here and in
# turbo.json's task env even though it has a built-in default: an undeclared
# variable is filtered out by Turborepo, so setting it would appear to do
# nothing while the fallback silently kept working.
# WEB_API_URL="http://localhost:3001"
#
# If a local service already holds 3001 or 3000 — the legacy Sitemap_Migration
# backend and frontend both do — override the ports rather than stopping it.
# Same class of collision as POSTGRES_PORT above.
# API_PORT=3001
# WEB_PORT=3000
# NODE_ENV="development"          # development | test | production
# LOG_LEVEL="info"                # trace | debug | info | warn | error | fatal
# API_PORT=3001
# WEB_PORT=3000
# DEFAULT_ORGANIZATION_SLUG="asapsemi-demo"  # placeholder until real auth (M7); matches scripts/seed-demo.ts

# ============================================================
# AWS (real low-traffic dev bucket, not LocalStack — see architecture doc note 5)
# ============================================================
# AWS_REGION="us-east-1"
# Commented out rather than set empty. AUTH_SECRET is optional but must be
# non-empty when present, so `# AUTH_SECRET=""` fails validation at startup — and
# the README tells you to `cp .env.example .env` and run `pnpm dev`, which would
# then break on the very first step. An absent variable is optional; an empty
# one is a value, and a bad one.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_DEV_BUCKET=""

# ============================================================
# Auth (Auth.js; internal RBAC for now, org boundary already in the schema)
# ============================================================
# AUTH_SECRET=""

# ============================================================
# ML service (Phase 4 — unused until ml-service/ is active)
# ============================================================
# ML_SERVICE_URL="http://localhost:8000"

# ============================================================
# Worker resource budgets
# ============================================================
# The worker's Postgres pool, budgeted apart from the API's so an ingest pass
# streaming a large site cannot starve the connections the API needs.
# WORKER_DB_POOL_SIZE=8
# Where downloaded sitemap files live between pipeline stages. Stages take the
# store as an interface, so an S3-backed store replaces this in M8 unchanged.
# SITEMAP_STORE_ROOT=.sitemaps

# ============================================================
# Parse budgets — memory and concurrency
# ============================================================
# Four threads is measured, not arbitrary: the box also runs Postgres and Redis.
# PARSE_MAX_THREADS=4
# Min-heap sample state ceiling (256 MB). On exceed, heaps flush and merge —
# merging min-heaps-by-hash is exact, which is what makes the cap safe mid-run.
# SAMPLE_HEAP_MAX_BYTES=268435456

# ============================================================
# Population thresholds — degrade, never silently truncate
# ============================================================
# POPULATION_SOFT_LIMIT_URLS=20000000    # continue at a reduced rate, flag DEGRADED
# POPULATION_HARD_LIMIT_URLS=100000000   # stop after counting; report the population
# POPULATION_HARD_LIMIT_FILES=50000

# ============================================================
# Sampling bounds (packages/sampling)
# ============================================================
# SAMPLE_MIN_SIZE=30
# SAMPLE_MAX_FIRST_ROUND=400
# SAMPLE_MAX_EXPANDED=1200
# SAMPLE_MAX_EXPANSION_FACTOR=3
# SAMPLE_MAX_POPULATION_FRACTION=0.25
# SAMPLE_MIN_PER_STRATUM=5
# Relative interval width thresholds. Shared deliberately between the adaptive
# expansion trigger and the UI's confidence bands, so the interface never flags
# a pattern the engine considers settled.
# CONFIDENCE_LOW_BAND_WIDTH=0.5
# CONFIDENCE_APPROXIMATE_BAND_WIDTH=0.2

# ============================================================
# Outbound HTTP budgets — these bound traffic at someone else's origin
# ============================================================
# Per-host values are measured. This project has been WAF-blocked once already.
# HTTP_PER_HOST_REQUESTS_PER_SECOND=25
# HTTP_PER_HOST_CONCURRENCY=8
# HTTP_PLATFORM_DAILY_REQUEST_CAP=5000000    # ~33-day cycle across 650 sites
# HTTP_PER_SITE_DAILY_REQUEST_CAP=250000     # one audit's worth per day
# HTTP_BUDGET_WARN_FRACTION=0.8
# HTTP_BUDGET_HALT_FRACTION=0.95             # stops new enqueues; in-flight finish
# Share of a pattern's sample allowed to escalate HEAD -> GET before the pattern
# is flagged for manual review instead of continuing to burn budget.
# HTTP_MAX_GET_ESCALATION_FRACTION=0.2
# Circuit breaker. A host answering 429/403 is refusing us, not reporting a
# broken page — patterns behind an open circuit are BLOCKED, never BROKEN.
# HTTP_CIRCUIT_BREAK_AFTER_429=5
# HTTP_CIRCUIT_BREAK_AFTER_403=10
# HTTP_CIRCUIT_COOLDOWN_MS=300000
